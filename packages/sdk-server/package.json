{
  "name": "@micaforge/sdk-server",
  "version": "0.1.0",
  "description": "Micaforge server-side SDK — ship agent hits, server-rendered pageviews and MCP server calls to Micaforge from Node, Workers, Deno, Bun or an access log",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/loruorg/micaforge/tree/main/packages/sdk-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loruorg/micaforge.git",
    "directory": "packages/sdk-server"
  },
  "keywords": [
    "analytics",
    "cookieless",
    "privacy",
    "server-side",
    "ai-agents",
    "crawlers",
    "log-shipper",
    "express",
    "fastify",
    "hono",
    "nextjs",
    "mcp",
    "model-context-protocol",
    "micaforge"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "micaforge-shipper": "./bin/micaforge-shipper.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
