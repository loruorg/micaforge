#==============================================================================
# Micaforge configuration.
#
#   cp .env.example .env
#
# This file is the inventory: every variable Micaforge reads is listed here,
# once, with what reads it and what happens when it is not set. If a variable is
# not in this file, nothing reads it.
#
# The server's own settings are the MICAFORGE_* block and come from
# apps/backend/crates/core/src/config.rs, which is where the defaults below are
# defined and enforced. The rest configure the containers around it in
# docker-compose.yml.
#
# Marked REQUIRED means the stack will not start without it, and will say so by
# name. Everything else has a default that works.
#
# `docker compose` reads this file automatically when it is named `.env`.
# `cargo run` reads it too, through dotenvy. It is in .gitignore. Keep it there:
# it holds the key every other key is derived from.
#==============================================================================


#------------------------------------------------------------------------------
# 1. REQUIRED. Four values, and ./install.sh fills in three of them for you.
#------------------------------------------------------------------------------

# The one operator secret. Session cookies, sealed credentials, share-link
# signatures and the ingest HMAC are all derived from it, so rotating it logs
# everyone out and makes stored secrets unreadable. 32 characters minimum,
# refused at boot below that.
#
#   openssl rand -base64 48
#
MICAFORGE_SECRET_KEY_BASE=

# Postgres and ClickHouse passwords. Both are interpolated into connection URLs,
# so keep them to characters that need no percent-encoding: hex is the safe
# choice and is what install.sh generates.
#
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=

# The address this install answers on, and the contact address Let's Encrypt
# sends certificate expiry warnings to. Read by Caddy (infra/caddy/Caddyfile).
#
# A hostname turns on automatic HTTPS:      MICAFORGE_DOMAIN=analytics.example.com
# The literal `:80` serves plain HTTP:      MICAFORGE_DOMAIN=:80
# Use `:80` on a laptop, or behind a proxy that already terminates TLS. Point
# the domain's DNS at this machine before starting, or the certificate order
# fails and Caddy retries with a backoff.
MICAFORGE_DOMAIN=:80
ACME_EMAIL=


#------------------------------------------------------------------------------
# 2. Public addresses
#------------------------------------------------------------------------------
# Both have to be addresses a browser can actually reach, not the address the
# server binds. They are printed into invitation emails, share links and the
# tracking snippet the setup screen hands you, so a wrong value here is a
# snippet that silently sends nothing.
#
# With a domain, both are https://your-domain. They are two variables because a
# managed install serves the dashboard from a CDN and the API from elsewhere.
#
# Optional. Default: http://localhost:8080 and http://localhost:4321 in the
# binary; http://localhost for both in docker-compose.yml.
MICAFORGE_PUBLIC_URL=http://localhost
MICAFORGE_DASHBOARD_URL=http://localhost


#------------------------------------------------------------------------------
# 3. Data stores
#------------------------------------------------------------------------------
# In the shipped compose file the three connection URLs are assembled from the
# parts below and the container names, so there is nothing to set here beyond
# the passwords in section 1. The URLs themselves are listed at the end of this
# section because they are what the binary reads, and because a local
# `cargo run` needs them spelled out.

# Optional. Defaults: micaforge / micaforge.
POSTGRES_USER=micaforge
POSTGRES_DB=micaforge

# Optional. Defaults: micaforge / micaforge. The ClickHouse image creates this
# user on start and removes the passwordless `default` account when it does.
CLICKHOUSE_USER=micaforge
CLICKHOUSE_DB=micaforge

# Postgres memory, for a 4 GB machine shared with ClickHouse. Raise
# shared_buffers to about a quarter of RAM on a bigger box, and
# effective_cache_size to about half. Optional.
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_CONNECTIONS=50

# Valkey memory ceiling. The working set is a salt per site per day, a counter
# per visitor per five minutes and one entry per live session, so this is a
# guard rail rather than a budget. Optional. Default: 256mb.
VALKEY_MAXMEMORY=256mb

# What the binary reads. REQUIRED for a local `cargo run`; set for you by
# docker-compose.yml, which points them at the container names.
#
# MICAFORGE_DATABASE_URL=postgres://micaforge:PASSWORD@127.0.0.1:5432/micaforge
# MICAFORGE_CLICKHOUSE_URL=http://127.0.0.1:8123
# MICAFORGE_REDIS_URL=redis://127.0.0.1:6379
#
# ClickHouse takes its database and credentials as three more variables rather
# than folding them into the URL, because the driver takes them separately:
#
# MICAFORGE_CLICKHOUSE_DB=micaforge
# MICAFORGE_CLICKHOUSE_USER=micaforge
# MICAFORGE_CLICKHOUSE_PASSWORD=
#
# Valkey speaks the Redis wire protocol, so the scheme stays redis://.


#------------------------------------------------------------------------------
# 4. Server behaviour
#------------------------------------------------------------------------------

# host:port the API binds inside the container. Optional. Default 0.0.0.0:8080.
# The compose file pins it and does not publish it: Caddy is the front door.
# MICAFORGE_BIND_ADDR=0.0.0.0:8080

# Registration is closed by default. The first account on an install is always
# allowed, closed or not, and becomes its owner; everyone after that joins by
# invitation. Set false to let anyone who can reach the dashboard sign up.
# Optional. Default: true here and in docker-compose.yml (false in the bare
# binary, for development).
MICAFORGE_DISABLE_REGISTRATION=true

# Limits for an install that lets anybody sign up. 0 means no limit, which is
# right for an install you run for yourself. Instance admins are never limited.
# Optional. Default: 0 and 0.
# MICAFORGE_MAX_SITES_PER_ORG=0
# MICAFORGE_MAX_ORGS_PER_USER=0

# Always true for an install you run yourself. It gates no feature, because
# there are none to gate (PRODUCT.md, principle 4); it selects the admin surface
# and guarantees no outbound call at runtime. Optional. Default: true.
MICAFORGE_SELF_HOSTED=true

# `json` for machine-readable logs, `text` for readable ones. Optional. Default
# text in the binary, json in the container, where something else reads them.
MICAFORGE_LOG_FORMAT=json

# Background jobs running at once: crawls, imports, scheduled reports, alert
# evaluation. Optional. Default: half the cores, minimum 2, maximum 16. Two is
# right for a 4 GB VPS, where the ingest path must not queue behind an import.
MICAFORGE_WORKER_CONCURRENCY=2

# How much each event table may buffer in memory while ClickHouse is away (a
# restart, an upgrade), in MiB. The writer keeps retrying and holds the hits
# meanwhile; past this it drops the oldest and logs how many. Six tables, so the
# worst case is six times this. Refused at boot outside 1-1024. Optional.
# Default: 32.
MICAFORGE_WRITER_BUFFER_MB=32

# Log verbosity for the Rust binary, in tracing's filter syntax. `info` is one
# line per start-up step and per error. `debug` includes every query. Ingest
# traffic logs under micaforge::access at debug, so it stays out of the log
# unless asked for: RUST_LOG=info,micaforge::access=debug. Optional.
# Default: info.
RUST_LOG=info

# Extra instance admins, comma separated. The first registered account is
# always one. A listed address counts only once its owner has verified it,
# which signing in with an emailed code does, so naming an address nobody has
# an account for yet gives nothing away. Optional.
MICAFORGE_ADMIN_EMAILS=

# Requests per minute per client address, across the whole API. A circuit
# breaker for a client stuck in a loop, not traffic policing: one office behind
# one address, with dashboards open, must stay well inside it. 0 switches it
# off. Refused at boot if it is not a number. Optional. Default: 3000.
MICAFORGE_RATE_LIMIT_PER_MIN=3000

# Extra origins allowed to call the API with a session, comma separated, for an
# install that serves the dashboard from a second hostname. MICAFORGE_PUBLIC_URL
# and MICAFORGE_DASHBOARD_URL are always allowed. Optional.
MICAFORGE_CORS_ORIGINS=

# Outbound requests (robots.txt and sitemap reads, webhooks, imports by URL)
# refuse private, loopback and link-local addresses, so a site record cannot be
# used to reach your database or a cloud metadata endpoint. Set true only if
# your webhooks really go to a host on your own network. Optional. Default: false.
MICAFORGE_ALLOW_PRIVATE_OUTBOUND=false


#------------------------------------------------------------------------------
# 4b. The edge: who the visitor is
#------------------------------------------------------------------------------
# The visitor address feeds the daily visitor hash and the rate limits, and is
# never stored. Getting it wrong merges every visitor into one.

# Proxies Caddy believes when they say who the visitor is (X-Forwarded-For),
# space separated CIDR ranges, or `private_ranges`. Empty trusts nobody, which
# is right when Caddy faces the internet directly. Behind a CDN, list the CDN's
# published ranges; behind your own proxy on the same network, private_ranges.
# Read by Caddy. Optional.
MICAFORGE_TRUSTED_PROXIES=

# The one header the server believes for the client address. Caddy writes
# X-Real-IP itself and overwrites any a client sent. Unset or `none` means the
# socket address only, which is right for a binary with no proxy in front.
# Optional. Default in docker-compose.yml: x-real-ip.
# MICAFORGE_TRUSTED_PROXY_HEADER=x-real-ip


#------------------------------------------------------------------------------
# 5. Retention
#------------------------------------------------------------------------------
# Applied as a ClickHouse TTL at boot, and re-applied whenever it changes.
# Because every event table is partitioned by month, expiry drops whole
# partitions rather than rewriting them.

# Days of event history. 0 means forever, and forever is the default: an
# analytics tool that quietly deleted history because a variable was unset would
# be indefensible. Optional.
MICAFORGE_RETENTION_DAYS=0

# Days of session replay. Metered separately because one replayed session
# outweighs a month of events on disk. Optional. Default: 30.
MICAFORGE_REPLAY_RETENTION_DAYS=30


#------------------------------------------------------------------------------
# 6. Geography (optional, and off by default)
#------------------------------------------------------------------------------
# Micaforge makes no outbound call to resolve an address, so geography needs a
# database on disk. Drop a MaxMind-compatible .mmdb into infra/geoip/ and point
# these at it, using the path inside the container.
#
# Without the city database, behind Cloudflare with
# MICAFORGE_TRUSTED_PROXY_HEADER=cf-connecting-ip: country from CF-IPCountry, and
# region, city and coordinates when the zone's "Add visitor location headers"
# managed transform is on. Otherwise no geography. Without the ASN database: no
# datacenter detection, which weakens agent verification without breaking it,
# since user-agent patterns and reverse DNS still apply.
#
# MICAFORGE_GEOIP_CITY_PATH=/geoip/GeoLite2-City.mmdb
# MICAFORGE_GEOIP_ASN_PATH=/geoip/GeoLite2-ASN.mmdb
MICAFORGE_GEOIP_CITY_PATH=
MICAFORGE_GEOIP_ASN_PATH=

# Where that directory lives on the host. Optional. Default: ./infra/geoip
MICAFORGE_GEOIP_DIR=./infra/geoip


#------------------------------------------------------------------------------
# 7. Mail (optional, and off by default)
#------------------------------------------------------------------------------
# Accounts have no password: every sign-in is a six-digit code sent by email.
# Two ways to send it. Cloudflare Email Sending wins when both of its variables
# are set; otherwise an SMTP relay is used when its URL is set; otherwise
# nothing is sent. Setting only one of the two Cloudflare variables stops the
# server at boot and names the missing one.
#
# With no transport, every email path degrades instead of failing: a sign-in
# code is printed on the host by the operator,
#
#   docker compose exec micaforge micaforge-server sign-in-code you@example.com
#
# invitations become links you copy from the dashboard, and scheduled reports
# do not run. No code, link or token is ever written to the log.
#
# Cloudflare: an API token allowed to send email, and the account it sends for.
MICAFORGE_CLOUDFLARE_EMAIL_TOKEN=
MICAFORGE_CLOUDFLARE_ACCOUNT_ID=
#
# SMTP:
#   MICAFORGE_SMTP_URL=smtp://user:password@smtp.example.com:587
#   MICAFORGE_SMTP_URL=smtps://user:password@smtp.example.com:465
#
MICAFORGE_SMTP_URL=
# The sender on every message. With either transport it has to be on a domain
# the provider lets you send from.
MICAFORGE_MAIL_FROM=Micaforge <noreply@localhost>
#
# "Continue with Google" and "Continue with GitHub" on the sign-in screen,
# beside the emailed code. Each provider is off until both its client id and
# its secret are set; one half alone stops the server at boot. Register this
# redirect address with the provider:
#   ${MICAFORGE_PUBLIC_URL}/api/auth/oauth/google/callback
#   ${MICAFORGE_PUBLIC_URL}/api/auth/oauth/github/callback
# Only verified email addresses sign in, through the same rules as the code.
MICAFORGE_GOOGLE_CLIENT_ID=
MICAFORGE_GOOGLE_CLIENT_SECRET=
MICAFORGE_GITHUB_CLIENT_ID=
MICAFORGE_GITHUB_CLIENT_SECRET=
#
# Billing: plans, event quotas, usage emails at 80% and 100%, and Stripe. For an
# operator who sells Micaforge as a service; leave it off on your own install.
# When on, MICAFORGE_BILLING_PLANS is required, and each plan's site limit
# replaces MICAFORGE_MAX_SITES_PER_ORG. Exactly one plan has no price_id: the
# free plan every organisation starts on. Events past a quota are still recorded.
#   MICAFORGE_BILLING_PLANS=[{"id":"free","name":"Free","events":10000,"sites":2,"members":3},{"id":"team","name":"Team","events":1000000,"sites":20,"members":25,"price_id":"price_123","price_label":"EUR 19 a month"}]
MICAFORGE_BILLING_ENABLED=false
MICAFORGE_BILLING_PLANS=
# Stripe Checkout, the Customer portal and the webhook at
# ${MICAFORGE_PUBLIC_URL}/api/billing/webhook. Both or neither; read only while
# billing is on. Without them, plans are not for sale.
MICAFORGE_STRIPE_SECRET_KEY=
MICAFORGE_STRIPE_WEBHOOK_SECRET=


#------------------------------------------------------------------------------
# 8. Images and ports
#------------------------------------------------------------------------------
# The server and web images are built from this checkout by default, tagged
# `local`. To run published images instead, set these three and run
# `docker compose pull` (or `./install.sh --version 0.1.0`):
#
#   MICAFORGE_IMAGE=ghcr.io/loruorg/micaforge
#   MICAFORGE_WEB_IMAGE=ghcr.io/loruorg/micaforge-web
#   MICAFORGE_VERSION=0.1.0
#
MICAFORGE_IMAGE=micaforge
MICAFORGE_WEB_IMAGE=micaforge-web
MICAFORGE_VERSION=local

# The stores are pinned to a major version (Postgres, Valkey) or an LTS line
# (ClickHouse), so a pull brings patch releases and never a format change.
# ClickHouse cannot be downgraded once it has written data: move that line
# deliberately, after ./backup.sh.
POSTGRES_IMAGE=postgres:17-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8-alpine
VALKEY_IMAGE=valkey/valkey:8-alpine

# Host ports Caddy publishes. Change them only if something else on the machine
# already holds 80 and 443; ACME's HTTP-01 challenge needs port 80 reachable
# from the internet on the standard port, so a certificate will not issue if you
# move it. Optional.
HTTP_PORT=80
HTTPS_PORT=443

# Where the server looks for mf.js and mf.min.js. The image carries the real
# tracker at /app/tracker, so leave these unset; they exist for a binary run
# outside the image. Unset and not found, the server serves a small compiled-in
# tracker that records pageviews only and reports sdk_version=fallback.
# MICAFORGE_TRACKER_PATH=
# MICAFORGE_TRACKER_MIN_PATH=


#------------------------------------------------------------------------------
# 9. The web app
#------------------------------------------------------------------------------
# These two are Astro's, not the server's, and they are read at BUILD time. The
# shipped stack needs neither: the web image calls the API on whatever origin
# served it, so one image works on every domain.

# Where the dashboard sends API requests, for a dashboard served from a
# different origin than the API (a CDN, `pnpm dev`). Default when unset: the
# page's own origin in a build, http://localhost:8330 under `pnpm dev`.
# PUBLIC_API_URL=

# The canonical origin of the marketing pages, for the sitemap and canonical
# URLs. Passed to the web image build by docker-compose.yml. Default:
# https://micaforge.com, which is right for a self-hosted copy of those pages.
# PUBLIC_SITE_URL=https://micaforge.com


#------------------------------------------------------------------------------
# 10. Local development
#------------------------------------------------------------------------------
# For `docker compose -f docker-compose.dev.yml up -d` plus `cargo run` plus
# `pnpm dev`. The dev compose file publishes the three stores on 127.0.0.1 with
# the password `micaforge_dev`, so the block below is the whole configuration a
# developer needs. Uncomment it, and comment out MICAFORGE_PUBLIC_URL and
# MICAFORGE_DASHBOARD_URL above.
#
# The ports match apps/web: the dev server runs on 4330 and apps/web/src/lib/api.ts
# falls back to 8330, so binding the API to 8330 makes both agree with no
# further configuration.
#
# The four DEV_* variables move the published store ports, for the common case
# of already having a Postgres or a Redis on the standard one. They are read
# only by docker-compose.dev.yml. Defaults: 5432, 8123, 9000, 6379.
#
# DEV_POSTGRES_PORT=5432
# DEV_CLICKHOUSE_HTTP_PORT=8123
# DEV_CLICKHOUSE_NATIVE_PORT=9000
# DEV_VALKEY_PORT=6379
#
# MICAFORGE_SECRET_KEY_BASE=development_only_not_a_secret_0000000000
# MICAFORGE_DATABASE_URL=postgres://micaforge:micaforge_dev@127.0.0.1:5432/micaforge
# MICAFORGE_CLICKHOUSE_URL=http://127.0.0.1:8123
# MICAFORGE_CLICKHOUSE_DB=micaforge
# MICAFORGE_CLICKHOUSE_USER=micaforge
# MICAFORGE_CLICKHOUSE_PASSWORD=micaforge_dev
# MICAFORGE_REDIS_URL=redis://127.0.0.1:6379
# MICAFORGE_BIND_ADDR=127.0.0.1:8330
# MICAFORGE_PUBLIC_URL=http://localhost:8330
# MICAFORGE_DASHBOARD_URL=http://localhost:4330
# MICAFORGE_LOG_FORMAT=text
# RUST_LOG=micaforge=debug,info
# PUBLIC_API_URL=http://localhost:8330
# PUBLIC_SITE_URL=http://localhost:4330


#------------------------------------------------------------------------------
# 11. AI analyst (optional, and off by default)
#------------------------------------------------------------------------------
# One OpenAI-compatible model serves every AI feature: Ask AI in the
# dashboard, the explanations on investigations, the MCP `ask` tool and the chat
# apps. The server POSTs to {MICAFORGE_LLM_BASE_URL}/chat/completions with tool
# calling, so the model must support tool calls. A hosted API or a local server
# on your own network both work.
#
# The base URL and the model go together: one without the other stops the
# server at boot and names the missing one. The key, the timeout and the limit
# set without a base URL stop the boot too, naming MICAFORGE_LLM_BASE_URL.
#
# Unset, no AI feature makes a call: the dashboard says AI is off, and
# investigations open with their statistical findings only.
#
# The API root, an absolute http or https URL:
#   MICAFORGE_LLM_BASE_URL=https://api.openai.com/v1
#   MICAFORGE_LLM_BASE_URL=http://ollama:11434/v1
MICAFORGE_LLM_BASE_URL=
# The model name the endpoint expects. Required when the base URL is set.
MICAFORGE_LLM_MODEL=
# Sent as a bearer token. Optional: a local server usually needs none. Never
# logged.
MICAFORGE_LLM_API_KEY=
# The ceiling on one model call, in seconds. An answer may take several calls.
# Refused at boot outside 5-120. Optional. Default: 45.
# MICAFORGE_LLM_TIMEOUT_SECS=45
# Questions per organisation per UTC day, shared by the dashboard, MCP, the
# chat apps and investigation explanations. 0 means no limit. Optional.
# Default: 0.
# MICAFORGE_LLM_DAILY_LIMIT=0


#------------------------------------------------------------------------------
# 12. Chat apps (optional, and off by default)
#------------------------------------------------------------------------------
# One Slack app, one Discord application and one Telegram bot per install, each
# answering questions about a site in the channels linked to it and posting new
# investigations there. Which channel belongs to which site is not set here: a
# member links it from Site setup -> Chat apps with a one-time code. Step-by-step
# setup for each platform: /docs/integrations/slack, /discord, /telegram.
#
# Each platform is all or nothing. Half of one stops the server at boot and
# names the missing variable. Every platform needs the install reachable from
# the internet over HTTPS, because the platform calls it.
#
# Slack: the Signing Secret (Basic Information -> App Credentials) and the Bot
# User OAuth Token (xoxb-...). Both or neither.
MICAFORGE_SLACK_SIGNING_SECRET=
MICAFORGE_SLACK_BOT_TOKEN=
#
# Discord: the Application ID and the Public Key (General Information) and the
# bot token (Bot -> Reset Token). All three or none. The public key is the
# 64-character hex key, checked at boot. Register the /micaforge command once
# they are set:
#
#   docker compose exec micaforge micaforge-server chat-setup discord
#
MICAFORGE_DISCORD_APPLICATION_ID=
MICAFORGE_DISCORD_PUBLIC_KEY=
MICAFORGE_DISCORD_BOT_TOKEN=
#
# Telegram: the token BotFather issued, and a webhook secret you choose: 1-256
# characters of A-Z a-z 0-9 _ -, checked at boot (openssl rand -hex 32 fits).
# Both or neither. Then point Telegram at this install, and again after any
# change to the secret or to MICAFORGE_PUBLIC_URL:
#
#   docker compose exec micaforge micaforge-server chat-setup telegram
#
MICAFORGE_TELEGRAM_BOT_TOKEN=
MICAFORGE_TELEGRAM_WEBHOOK_SECRET=


#------------------------------------------------------------------------------
# 13. Feedback channel (optional, and off by default)
#------------------------------------------------------------------------------
# New feedback is always emailed to every instance admin when mail is
# configured (section 7). These add a channel beside the inbox.
#
# A Slack incoming webhook (or any endpoint that accepts the same JSON body), or
# a Discord webhook, recognised by its discord.com or discordapp.com host. Must
# be an http or https URL. Optional.
MICAFORGE_FEEDBACK_WEBHOOK_URL=
# A Telegram chat the install's own bot posts each new report to. Needs the
# Telegram bot in section 12; set without MICAFORGE_TELEGRAM_BOT_TOKEN, it
# stops the boot. Optional.
MICAFORGE_FEEDBACK_TELEGRAM_CHAT_ID=


#------------------------------------------------------------------------------
# 14. Monitoring and growth
#------------------------------------------------------------------------------

# The probe region label written on every uptime check. One install checks
# from one place, so this names that place; it is stored on every check so that
# a later install that checks from more than one place can tell the results
# apart. Any short name: letters, digits, `-` and `_`, up to 32 characters.
# Refused at boot otherwise. Optional. Default: default.
# MICAFORGE_REGION=default

# A bare hostname that also serves short links at its root, such as
# go.example.com, which answers https://go.example.com/<slug>. The scheme
# follows MICAFORGE_PUBLIC_URL. A scheme, a port or a path is refused at boot.
# Point the host's DNS at this machine and give it its own site block in
# infra/caddy/Caddyfile (docs: /docs/dashboard/short-links). Optional. Default:
# unset, which serves short links only at <API origin>/l/<slug>.
# MICAFORGE_LINKS_HOST=


#------------------------------------------------------------------------------
# 15. Google Search Console (optional, and off by default)
#------------------------------------------------------------------------------
# Lets a site admin connect a Google Search Console property, so the Search
# screen shows what people searched on Google before they arrived. Both or
# neither; one alone stops the boot. With neither, no site can connect and
# nothing is sent to Google.
#
# A Google Cloud OAuth client of type "Web application", in a project with the
# Google Search Console API turned on. Register this redirect address on it:
#   ${MICAFORGE_PUBLIC_URL}/api/search-console/callback
# A client of its own rather than the sign-in one (section 7): Search Console
# needs the webmasters.readonly scope, which Google reviews, and sign-in needs
# none that it does. The same client may be pasted into both pairs if both
# redirect addresses are registered on it.
# Docs: /docs/integrations/google-search-console
MICAFORGE_SEARCH_CONSOLE_CLIENT_ID=
MICAFORGE_SEARCH_CONSOLE_CLIENT_SECRET=

#------------------------------------------------------------------------------
# 16. GitHub App (optional, and off by default)
#------------------------------------------------------------------------------
# Puts each site's deploys, releases and pushes on its charts as annotations,
# and opens feedback as GitHub issues. All six or none; part of the group stops
# the boot and names the missing variable. With none set, nothing is sent to
# GitHub and the webhook refuses every delivery. Setup: /docs/integrations/github
#
# Separate from MICAFORGE_GITHUB_CLIENT_ID/_SECRET in section 7, which are the
# OAuth app behind "Continue with GitHub". Either can be set without the other.
#
# On GitHub, the App's callback URL is <MICAFORGE_PUBLIC_URL>/api/github/callback
# with "Request user authorization (OAuth) during installation" on, and its
# webhook URL is <MICAFORGE_PUBLIC_URL>/api/github/webhook. Permissions: Contents
# read, Deployments read, Issues read and write, Metadata read. Events: Push,
# Release, Deployment status.
#
# The numeric App ID, and the name in github.com/apps/<slug>.
MICAFORGE_GITHUB_APP_ID=
MICAFORGE_GITHUB_APP_SLUG=
# The private key GitHub generated (.pem). On one line, write its line breaks
# as \n; the server turns them back and checks at boot that it can sign with it.
MICAFORGE_GITHUB_APP_PRIVATE_KEY=
# The webhook secret you set on the App (openssl rand -hex 32 fits).
MICAFORGE_GITHUB_APP_WEBHOOK_SECRET=
# The App's own client ID and a client secret generated on its page. Used during
# an install to check, with the person's own GitHub authorisation, that the
# installation they come back with is one they can reach.
MICAFORGE_GITHUB_APP_CLIENT_ID=
MICAFORGE_GITHUB_APP_CLIENT_SECRET=
