{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "verbatimModuleSyntax": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "functions/**/*", "*.mjs"],
  "exclude": ["dist", "node_modules"]
}
