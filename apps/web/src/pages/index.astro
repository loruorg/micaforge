---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DashboardPreview from "../components/home/DashboardPreview.astro";
import {
  IconAlert,
  IconCheck,
  IconClock,
  IconDashboards,
  IconDevices,
  IconDownload,
  IconEvents,
  IconExperiments,
  IconFunnel,
  IconGoals,
  IconJourneys,
  IconLocations,
  IconPages,
  IconPerformance,
  IconQuery,
  IconRetention,
  IconSources,
} from "../components/react/icons.tsx";
import { CHANNEL_SPLIT, CRAWLERS, GAP_PAGES } from "../lib/home-demo";
import "../styles/home.css";

const title = "Micaforge: open-source web analytics for the AI search era";
const description =
  "Privacy-friendly, open-source web analytics. See the visitors ChatGPT, Perplexity and Google send you, and which AI crawlers read your site.";

const nf = new Intl.NumberFormat("en-US");
const maxCrawled = Math.max(...GAP_PAGES.map((p) => p.crawled));

const FEATURES = [
  { Icon: IconClock, name: "Realtime", hint: "Who is on now" },
  { Icon: IconPages, name: "Pages", hint: "Top, entry and exit" },
  { Icon: IconSources, name: "Sources", hint: "Referrers and UTMs" },
  { Icon: IconLocations, name: "Locations", hint: "Country to city" },
  { Icon: IconDevices, name: "Devices", hint: "Browser, OS, screen" },
  { Icon: IconEvents, name: "Custom events", hint: "With properties" },
  { Icon: IconGoals, name: "Goals", hint: "Conversions" },
  { Icon: IconFunnel, name: "Funnels", hint: "Find the drop-off" },
  { Icon: IconJourneys, name: "Journeys", hint: "Paths between pages" },
  { Icon: IconRetention, name: "Retention", hint: "Who comes back" },
  { Icon: IconPerformance, name: "Web Vitals", hint: "By page and device" },
  { Icon: IconAlert, name: "Reports and alerts", hint: "Email, Slack, webhook" },
  { Icon: IconExperiments, name: "Feature flags", hint: "Roll out safely" },
  { Icon: IconDashboards, name: "Shared dashboards", hint: "Public or private link" },
  { Icon: IconQuery, name: "Stats API", hint: "And CSV export" },
  { Icon: IconDownload, name: "Imports", hint: "From GA and Plausible" },
];

const FAQ = [
  {
    q: "Does Micaforge use cookies?",
    a: "No. Visitors are counted with a salted hash that changes every day. No cookies, no raw IP addresses and no personal data are stored.",
  },
  {
    q: "Which AI tools and crawlers does it recognize?",
    a: "Visits sent by ChatGPT, Perplexity, Claude, Gemini and Copilot, and crawlers such as GPTBot, OAI-SearchBot, ChatGPT-User, ClaudeBot, PerplexityBot, Googlebot, Applebot, Bytespider and CCBot. Crawler claims are checked against the IP ranges each company publishes.",
  },
  {
    q: "How can it see crawlers that do not run JavaScript?",
    a: "The script counts people. Crawlers are read from your server log or from a few lines of edge middleware that report each fetch to Micaforge.",
  },
  {
    q: "Is it free?",
    a: "The hosted version is free during the beta. The software is open source under AGPL-3.0, and you can self-host it for free.",
  },
  {
    q: "Can I bring my Google Analytics history?",
    a: "Yes. You can import your history from Google Analytics, Plausible and Umami.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Micaforge",
    url: "https://micaforge.com/",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    description,
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description} bare>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="mf-page">
    <SiteHeader />

    <main id="main" class="home">
      <section class="hero" aria-labelledby="hero-h">
        <div class="mf-wrap hero__text">
          <h1 id="hero-h">Web analytics for the AI&nbsp;search era</h1>
          <p class="hero__sub">
            See the visitors ChatGPT, Perplexity and Google send you, and every AI crawler that reads your
            site. Open source, cookie-free, and set up in two minutes.
          </p>
          <div class="hero__acts">
            <a class="mf-cta" href="/app/">
              Start free
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
                ><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
              >
            </a>
            <a class="mf-cta mf-cta--ghost" href="/self-host">Self-host</a>
          </div>
          <p class="hero__fine">Free during beta · No credit card · No cookie banner</p>
        </div>
        <div class="mf-wrap hero__shot">
          <DashboardPreview />
        </div>
      </section>

      <section class="sec" id="features" aria-labelledby="ai-h">
        <div class="mf-wrap">
          <header class="sec__head">
            <h2 id="ai-h">Your next customers ask an AI first</h2>
            <p>
              Most analytics tools drop AI crawlers as bots and lump AI answers into referrals. Micaforge shows both.{" "}
              <a href="/why-agent-analytics">Why it matters</a>
            </p>
          </header>

          <div class="feat">
            <div class="feat__text">
              <h3>See which AI answers send you visitors</h3>
              <p>
                ChatGPT, Perplexity, Claude, Gemini and Copilot get their own channel next to Search and Social, with
                the same goals and conversions.
              </p>
            </div>
            <div class="feat__vis mf-panel" data-reveal>
              <div class="vis-head">
                <span>Visitors by channel</span>
                <span class="vis-demo">Demo data</span>
              </div>
              <div class="split" role="img" aria-label="Search 41%, Direct 24%, Referral 15%, AI answers 11%, Social 9%">
                {CHANNEL_SPLIT.map((c, i) => <span class="split__seg" data-key={c.key} style={`--w:${c.share}%;--i:${i}`} />)}
              </div>
              <ul class="split__legend">
                {
                  CHANNEL_SPLIT.map((c) => (
                    <li data-key={c.key}>
                      <i aria-hidden="true" />
                      <span>{c.label}</span>
                      <strong>{c.share}%</strong>
                    </li>
                  ))
                }
              </ul>
              <p class="vis-foot"><strong>AI answers</strong> grew 3.2× in 90 days</p>
            </div>
          </div>

          <div class="feat feat--flip">
            <div class="feat__text">
              <h3>Know every AI crawler by name</h3>
              <p>
                Each crawler is named by company and purpose and checked against the IP ranges that company publishes.
                Fakes are flagged, and you see who ignores your robots.txt.
              </p>
            </div>
            <div class="feat__vis mf-panel" data-reveal>
              <div class="vis-head">
                <span>AI crawlers this month</span>
                <span class="vis-demo">Demo data</span>
              </div>
              <table class="crawl">
                <thead>
                  <tr><th scope="col">Crawler</th><th scope="col">Purpose</th><th scope="col" class="is-num">Visits</th><th scope="col">Identity</th></tr>
                </thead>
                <tbody>
                  {
                    CRAWLERS.map((c, i) => (
                      <tr data-state={c.state} style={`--i:${i}`}>
                        <th scope="row">
                          {c.name}
                          <span>{c.owner}</span>
                        </th>
                        <td>{c.purpose}</td>
                        <td class="is-num">{nf.format(c.visits)}</td>
                        <td>
                          <span class="crawl__id">
                            {c.state === "verified" ? "Verified" : "Fake: wrong IP range"}
                          </span>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>

          <div class="feat">
            <div class="feat__text">
              <h3>Find the pages AI reads but never credits</h3>
              <p>
                For every page, compare how often AI crawled it with how many readers came back from an answer. Then
                write more of what works.
              </p>
            </div>
            <div class="feat__vis mf-panel" data-reveal>
              <div class="vis-head">
                <span>Crawled vs. visitors sent back</span>
                <span class="vis-demo">Demo data</span>
              </div>
              <ul class="gap">
                {
                  GAP_PAGES.map((p, i) => (
                    <li style={`--i:${i}`}>
                      <span class="gap__path">{p.path}</span>
                      <span class="gap__bars">
                        <span class="gap__bar" data-key="ai" style={`--w:${(p.crawled / maxCrawled).toFixed(3)}`}>
                          <em>{nf.format(p.crawled)} crawls</em>
                        </span>
                        <span class="gap__bar" data-key="people" style={`--w:${(p.returned / maxCrawled).toFixed(3)}`}>
                          <em>{nf.format(p.returned)} visitors</em>
                        </span>
                      </span>
                      <span class="gap__verdict" data-good={p.returned / p.crawled > 0.05 ? "true" : "false"}>
                        {p.returned / p.crawled > 0.05 ? "Cited" : "Not credited"}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="sec sec--tint" aria-labelledby="all-h">
        <div class="mf-wrap">
          <header class="sec__head">
            <h2 id="all-h">Everything else you expect from analytics</h2>
            <p>One script and one dashboard for the reports you check every day.</p>
          </header>
          <ul class="grid">
            {
              FEATURES.map(({ Icon, name, hint }) => (
                <li>
                  <span class="grid__icon"><Icon size={18} /></span>
                  <span class="grid__name">{name}</span>
                  <span class="grid__hint">{hint}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="sec" aria-labelledby="setup-h">
        <div class="mf-wrap setup">
          <div class="setup__text">
            <h2 id="setup-h">Private by default. Live in two minutes.</h2>
            <ul class="checks">
              <li><IconCheck size={16} /> No cookies and no consent banner</li>
              <li><IconCheck size={16} /> No personal data or IP addresses stored</li>
              <li><IconCheck size={16} /> Script under 3 KB, never blocks your page</li>
              <li><IconCheck size={16} /> Your data stays yours: export it any time</li>
            </ul>
          </div>
          <ol class="steps">
            <li>
              <span class="steps__n">1</span>
              <div>
                <h3>Add your site</h3>
                <p>Sign in with your email. No password.</p>
              </div>
            </li>
            <li>
              <span class="steps__n">2</span>
              <div>
                <h3>Paste one line</h3>
                <pre class="steps__code"><code>&lt;script defer src="https://api.micaforge.com/mf.js"
  data-site="1"&gt;&lt;/script&gt;</code></pre>
              </div>
            </li>
            <li>
              <span class="steps__n">3</span>
              <div>
                <h3>Watch visitors arrive</h3>
                <p>The first visit shows up in seconds.</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="oss" aria-labelledby="oss-h">
        <div class="mf-wrap oss__inner">
          <div>
            <h2 id="oss-h">Open source. Self-host whenever you want.</h2>
            <p>
              Micaforge is AGPL-3.0. The hosted version and the self-hosted build are the same software, with no paid
              features held back. Run it on one small server with Docker.
            </p>
          </div>
          <div class="oss__acts">
            <a class="mf-cta oss__cta" href="/self-host">Self-hosting guide</a>
            <a class="mf-cta mf-cta--ghost oss__ghost" href="https://github.com/loruorg/micaforge" rel="noopener">View on GitHub</a>
          </div>
        </div>
      </section>

      <section class="sec" aria-labelledby="faq-h">
        <div class="mf-wrap faq">
          <h2 id="faq-h">Questions</h2>
          <div class="faq__list">
            {
              FAQ.map((f) => (
                <details class="faq__item">
                  <summary>
                    {f.q}
                    <span class="faq__plus" aria-hidden="true" />
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="close" aria-labelledby="close-h">
        <div class="mf-wrap close__inner">
          <h2 id="close-h">See what AI does with your site</h2>
          <p>Free during the beta. Set up in two minutes.</p>
          <div class="hero__acts">
            <a class="mf-cta" href="/app/">Start free</a>
            <a class="mf-cta mf-cta--ghost" href="/docs">Read the docs</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Base>

<script>
  import { startHomeMotion } from "../lib/home-motion";
  startHomeMotion();
</script>
