---
/**
 * The contents sheet.
 *
 * A manual opens with its register, not with a grid of tiles: every section, every page
 * it holds, one rule between them. The install snippet sits at the top because it is the
 * first thing anyone actually came here for.
 */
import Docs from "../../layouts/Docs.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { getCollection } from "astro:content";
import { docHref, sections } from "../../lib/docs";
import { GUIDES_HREF, guideHref, ordered } from "../../lib/guides";

const snippet = `<script
  defer
  data-site="1"
  data-host="https://analytics.example.com"
  src="https://analytics.example.com/mf.js"
></script>`;

const entries = await getCollection("docs");
const register = sections(entries);
const guides = ordered(await getCollection("guides"));
const pages = register.reduce((n, s) => n + s.docs.length, 0) + guides.length;
---

<Docs
  title="Documentation · Micaforge"
  description="How to install Micaforge, what it records, how agent traffic and the Citation Gap are measured, and how to run the whole thing yourself."
  section="docs"
  rail={false}
  prose={false}
>
  <div class="doc-open">
    <header class="doc-open__head">
      <h1 class="doc-open__title">Documentation</h1>
      <p class="doc-open__lead">
        {pages} pages: installing the tracker, everything it reports, how AI crawlers and AI
        referrals are counted, and how to self-host. Where a capability is not built yet, the
        page says so instead of describing it.
      </p>
    </header>

    <div class="doc-open__snippet">
      <CodeBlock>
        <code class="language-html" set:text={snippet} />
      </CodeBlock>
      <p class="doc-open__snippet-note">
        That line counts people. AI crawlers never run it, so they are read from your server
        log or your edge middleware instead.
      </p>
    </div>

    <div class="doc-register">
      {
        register.map((section, i) => (
          <>
            <section class="doc-register__row">
              <div>
                <h2 class="doc-register__name">{section.group.label}</h2>
                <p class="doc-register__gloss">{section.group.gloss}</p>
              </div>
              <ul class="doc-register__list">
                {section.docs.map((doc) => (
                  <li>
                    <a class="doc-register__link" href={docHref(doc.id)}>
                      {doc.data.title}
                      <span>{doc.data.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
            {i === 0 && guides.length > 0 && (
              <section class="doc-register__row">
                <div>
                  <h2 class="doc-register__name">
                    <a href={GUIDES_HREF}>Guides</a>
                  </h2>
                  <p class="doc-register__gloss">One task per page, from start to finish.</p>
                </div>
                <ul class="doc-register__list">
                  {guides.map((g) => (
                    <li>
                      <a class="doc-register__link" href={guideHref(g.id)}>
                        {g.data.title}
                        <span>{g.data.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </>
        ))
      }
    </div>
  </div>
</Docs>
