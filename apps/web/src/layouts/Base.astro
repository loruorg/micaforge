---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Marketing pages get the wide reading shell; the app supplies its own. */
  bare?: boolean;
  ogImage?: string;
}

const { title, description, bare = false, ogImage = "/og/default.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://micaforge.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(ogImage, canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />

    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fafafa" />
    <slot name="head" />
  </head>
  <body>
    <!--
      THESIS: The analytics a small SaaS or developer-tool team opens every morning, plus
      the view nobody else ships: visitors sent by AI answers and the AI crawlers reading
      the site. Refuses the GA4 report wall and the metaphor-heavy instrument look.
      OWN-WORLD: The category standard, light only. Zinc neutrals on #fafafa, white
      panels with hairline edges and soft offset shadows, near-black ink and buttons,
      Geist and Geist Mono. Blue means people and orange means AI, on every surface.
      STORY: A founder sees a real dashboard, spots ChatGPT among the sources, learns
      Micaforge shows AI traffic without cookies, and starts free.
      FIRST VIEWPORT: Headline and one sentence on the left, Start free and Self-host
      buttons; a full-width live dashboard preview below (labelled demo data).
      FORM: category standard, chosen by the user over the roll; seed 670285ec.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish
      review, the verdict, and DESIGN.md
    -->
    <a class="mf-skip" href="#main">Skip to content</a>
    {
      bare ? (
        <slot />
      ) : (
        <div class="mf-page">
          <slot />
        </div>
      )
    }
    <style is:global>
      .mf-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: var(--mf-3) var(--mf-5);
        background: var(--mf-ground-2);
        color: var(--mf-ink);
        border: 1px solid var(--mf-rule-strong);
        border-radius: var(--mf-r-sm);
      }
      .mf-skip:focus {
        left: var(--mf-4);
        top: var(--mf-4);
      }
      .mf-page {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
    </style>
    <script>
      import { armPens } from "../lib/pen";
      armPens();
    </script>
  </body>
</html>
