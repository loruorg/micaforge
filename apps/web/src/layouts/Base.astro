---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Marketing pages get the wide reading shell; the app supplies its own. */
  bare?: boolean;
  ogImage?: string;
}

const { title, description, bare = false, ogImage = "/og/default.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://micaforge.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(ogImage, canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Micaforge: web analytics that shows your AI traffic" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />

    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fafafa" />
    <slot name="head" />
    <!--
      micaforge.com is measured by Micaforge itself (site 4), on the public pages of the
      production hostname only: not the dashboard, not a share page, not a customer's status
      page, not a preview build.
    -->
    <script is:inline>
      (function () {
        var h = location.hostname;
        var p = location.pathname;
        if (h !== "micaforge.com" && h !== "www.micaforge.com") return;
        if (p.indexOf("/app") === 0 || p.indexOf("/share") === 0) return;
        if (p.indexOf("/status/") === 0) return;
        var s = document.createElement("script");
        s.defer = true;
        s.src = "https://api.micaforge.com/mf.js";
        s.setAttribute("data-site", "4");
        document.head.appendChild(s);
      })();
    </script>
  </head>
  <body>
    <!--
      THESIS: The analytics a small SaaS or developer-tool team opens every morning, plus
      the view nobody else ships: visitors sent by AI answers and the AI crawlers reading
      the site. Refuses the GA4 report wall and the metaphor-heavy instrument look.
      OWN-WORLD: The category standard, light only. A white page with #fafafa bands (the
      dashboard sits on #fafafa), white panels with hairline edges and soft offset shadows,
      near-black ink and buttons, Geist and Geist Mono. Blue means people and orange means
      AI, on every surface.
      STORY: A founder sees a real dashboard, spots ChatGPT among the sources, learns
      Micaforge shows AI traffic without cookies, and starts free.
      FIRST VIEWPORT: Centred headline and one sentence, Start free and Self-host buttons;
      a full-width live dashboard preview below (labelled demo data).
      FORM: category standard, chosen by the user over the roll; seed 670285ec.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish
      review, the verdict, and DESIGN.md
    -->
    <a class="mf-skip" href="#main">Skip to content</a>
    {
      bare ? (
        <slot />
      ) : (
        <div class="mf-page">
          <slot />
        </div>
      )
    }
    <style is:global>
      .mf-skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: var(--mf-3) var(--mf-5);
        background: var(--mf-ground-2);
        color: var(--mf-ink);
        border: 1px solid var(--mf-rule-strong);
        border-radius: var(--mf-r-sm);
      }
      .mf-skip:focus {
        left: var(--mf-4);
        top: var(--mf-4);
      }
      .mf-page {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
    </style>
    <script>
      import { armPens } from "../lib/pen";
      armPens();
    </script>
  </body>
</html>
