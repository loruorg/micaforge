---
/**
 * The site header: brand, the few sections a visitor looks for, and the two
 * ways in (sign in, start free).
 *
 * Both menus are native <details> elements, so every control here works with
 * JavaScript switched off. The inline script only adds outside-click and
 * Escape, which <details> does not do by itself.
 */
import "../styles/site.css";
import { Mark, IconChevron, IconOut } from "./react/icons.tsx";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const COMPARE = [
  { href: "/vs/google-analytics", label: "vs Google Analytics" },
  { href: "/vs/plausible", label: "vs Plausible" },
];

const NAV = [
  { href: "/#features", label: "Features" },
  { href: "/why-agent-analytics", label: "AI traffic" },
  { href: "/self-host", label: "Self-host" },
  { href: "/docs", label: "Docs" },
];

const REPO = "https://github.com/loruorg/micaforge";

/** `/docs` stays lit while any page under it is being read. */
const within = (href: string) => !href.includes("#") && (path === href || path.startsWith(`${href}/`));
const inCompare = COMPARE.some((c) => path === c.href);
---

<header class="mf-head">
  <div class="mf-wrap mf-head__row">
    <a class="mf-head__brand" href="/" aria-label="Micaforge home">
      <Mark size={26} />
      <span class="mf-head__wordmark">Micaforge</span>
    </a>

    <nav class="mf-head__nav" aria-label="Sections">
      {
        NAV.map((n) => (
          <a
            class:list={["mf-nav__link", within(n.href) && "is-here"]}
            href={n.href}
            aria-current={within(n.href) ? "page" : undefined}
          >
            {n.label}
          </a>
        ))
      }
      <details class="mf-nav__disc" data-disc>
        <summary class:list={["mf-nav__link", inCompare && "is-here"]}>
          Compare
          <IconChevron size={13} className="mf-nav__caret" />
        </summary>
        <div class="mf-nav__menu">
          {
            COMPARE.map((c) => (
              <a
                href={c.href}
                class:list={[path === c.href && "is-here"]}
                aria-current={path === c.href ? "page" : undefined}
              >
                {c.label}
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <div class="mf-head__acts">
      <a class="mf-head__gh" href={REPO} rel="noopener" aria-label="Source on GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <a class="mf-head__signin" href="/app/">Sign in</a>
      <a class="mf-cta mf-cta--sm" href="/app/">Start free</a>

      <details class="mf-head__drawer" data-disc>
        <summary aria-label="Menu">
          <span class="mf-head__burger" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <div class="mf-drawer__panel">
          <div class="mf-wrap mf-drawer__list">
            {NAV.map((n) => <a href={n.href} class:list={[within(n.href) && "is-here"]}>{n.label}</a>)}
            {
              COMPARE.map((c) => (
                <a href={c.href} class:list={[path === c.href && "is-here"]}>
                  Micaforge {c.label}
                </a>
              ))
            }
            <a href={REPO} rel="noopener">
              Source on GitHub <IconOut size={13} />
            </a>
            <a href="/app/">Sign in</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var discs = document.querySelectorAll("[data-disc]");
    function closeAll(except) {
      for (var j = 0; j < discs.length; j++) {
        if (discs[j] !== except) discs[j].open = false;
      }
    }
    document.addEventListener("click", function (e) {
      var inside = null;
      for (var j = 0; j < discs.length; j++) {
        if (discs[j].contains(e.target)) inside = discs[j];
      }
      closeAll(inside);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      var open = null;
      for (var j = 0; j < discs.length; j++) {
        if (discs[j].open) open = discs[j];
      }
      if (!open) return;
      open.open = false;
      var s = open.querySelector("summary");
      if (s) s.focus();
    });
  })();
</script>
