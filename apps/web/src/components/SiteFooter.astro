---
/**
 * The site footer: the brand line, four short link columns, and the licence.
 */
import "../styles/site.css";
import { Mark, IconOut } from "./react/icons.tsx";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const REPO = "https://github.com/loruorg/micaforge";

const COLUMNS: { title: string; links: { href: string; label: string; out?: boolean }[] }[] = [
  {
    title: "Product",
    links: [
      { href: "/#features", label: "Features" },
      { href: "/why-agent-analytics", label: "AI traffic analytics" },
      { href: "/self-host", label: "Self-host" },
      { href: "/changelog", label: "Changelog" },
    ],
  },
  {
    title: "Compare",
    links: [
      { href: "/vs/google-analytics", label: "vs Google Analytics" },
      { href: "/vs/plausible", label: "vs Plausible" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "/docs", label: "Documentation" },
      { href: "/docs/guides/", label: "Guides" },
      { href: "/blog", label: "Blog" },
      { href: REPO, label: "GitHub", out: true },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/dpa", label: "Data processing" },
    ],
  },
];
---

<footer class="mf-foot">
  <div class="mf-wrap mf-foot__grid">
    <div class="mf-foot__brand">
      <a class="mf-foot__mark" href="/" aria-label="Micaforge home">
        <Mark size={26} />
        <span class="mf-foot__wordmark">Micaforge</span>
      </a>
      <p class="mf-foot__line">Open-source web analytics that shows what AI does with your site.</p>
    </div>

    {
      COLUMNS.map((col) => (
        <div class="mf-foot__col">
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel={l.out ? "noopener" : undefined}
                  aria-current={path === l.href ? "page" : undefined}
                >
                  {l.label}
                  {l.out && <IconOut size={13} />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mf-wrap">
    <div class="mf-foot__colophon">
      <span>© {new Date().getFullYear()} Micaforge</span>
      <span>Server and dashboard AGPL-3.0, tracker and SDK MIT</span>
      <span>No cookies, no personal data</span>
    </div>
  </div>
</footer>
