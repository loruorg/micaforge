---
/**
 * The sheet foot.
 *
 * The head of the page carries the sprocket strip the paper was fed in on; the
 * foot carries the one it was torn off at. Between them the whole page reads as
 * a single sheet, which is the point.
 *
 * Everything sits on the same grid, at the same margins, as the content above:
 * five tracks, the brand occupying the first, no tagline flung to one rim with
 * the link columns jammed against the other.
 */
import "../styles/site.css";
import { Mark, IconOut } from "./react/icons.tsx";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const REPO = "https://github.com/micaforge/micaforge";

const COLUMNS: { title: string; links: { href: string; label: string; out?: boolean }[] }[] = [
  {
    title: "The record",
    links: [
      { href: "/why-agent-analytics", label: "Why agent analytics" },
      { href: "/why-agent-analytics#citation-gap", label: "The Citation Gap" },
      { href: "/self-host", label: "Self-host" },
      { href: "/docs", label: "Documentation" },
    ],
  },
  {
    title: "Comparisons",
    links: [
      { href: "/vs/plausible", label: "vs Plausible" },
      { href: "/vs/google-analytics", label: "vs Google Analytics" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "/blog", label: "Writing" },
      { href: "/changelog", label: "Changelog" },
      { href: REPO, label: "Source", out: true },
      { href: `${REPO}/blob/main/docs/CONTRACT.md`, label: "Build contract", out: true },
      { href: `${REPO}/blob/main/LICENSE`, label: "AGPL-3.0 licence", out: true },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/dpa", label: "Data processing" },
    ],
  },
];
---

<footer class="mf-foot">
  <div class="mf-wrap mf-foot__grid">
    <div class="mf-foot__brand">
      <a class="mf-foot__mark" href="/">
        <Mark size={30} />
        <span class="mf-foot__wordmark">Micaforge</span>
      </a>
      <p class="mf-foot__line">
        Cookieless analytics that counts machine readers as an audience, then reports what
        came back.
      </p>
    </div>

    {
      COLUMNS.map((col) => (
        <div class="mf-foot__col">
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel={l.out ? "noopener" : undefined}
                  aria-current={path === l.href ? "page" : undefined}
                >
                  {l.label}
                  {l.out && <IconOut size={13} />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mf-wrap">
    <div class="mf-foot__colophon">
      <span><strong>AGPL-3.0</strong> server and dashboard · <strong>MIT</strong> tracker and SDK</span>
      <span>Pre-release. No hosted service, no tagged release.</span>
      <span>Self-hosted installs make no outbound call at runtime.</span>
    </div>
  </div>

  <div class="mf-feed mf-feed--foot" aria-hidden="true"></div>
</footer>
