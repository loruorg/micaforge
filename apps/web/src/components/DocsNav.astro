---
/**
 * The manual's left index: every page, grouped by section.
 *
 * It is a disclosure so that a narrow screen is not asked to scroll past fifty links to
 * reach the article. The element ships OPEN, which is what a reader with no JavaScript,
 * and every crawler, gets. The script below only ever CLOSES it, and only on a narrow
 * viewport: no link's existence depends on a script running.
 */
import { sections, docHref, type DocEntry } from "../lib/docs";
import { GUIDES_HREF, guideHref, ordered, type GuideEntry } from "../lib/guides";

interface Props {
  entries: DocEntry[];
  /** The task guides, listed as their own bank after Getting started. */
  guides?: GuideEntry[];
  /** The id of the page being read, e.g. `agents/the-citation-gap`, `guides/<id>` or `guides`. */
  current?: string;
}

const { entries, guides = [], current } = Astro.props;
const groups = sections(entries);
const tasks = ordered(guides);
const count = groups.reduce((n, g) => n + g.docs.length, 0) + tasks.length;
---

<details class="doc-index" open>
  <summary class="doc-index__summary">
    <span>Contents</span>
    <span class="doc-index__count mf-data">{count}</span>
  </summary>

  <nav class="doc-index__nav" aria-label="Documentation">
    {
      groups.map((section, i) => (
        <>
          <div class="doc-bank">
            <p class="doc-bank__label">{section.group.label}</p>
            <ul class="doc-bank__list">
              {section.docs.map((doc) => (
                <li>
                  <a
                    class="doc-bank__link"
                    href={docHref(doc.id)}
                    aria-current={doc.id === current ? "page" : undefined}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          {i === 0 && tasks.length > 0 && (
            <div class="doc-bank">
              <p class="doc-bank__label">Guides</p>
              <ul class="doc-bank__list">
                <li>
                  <a
                    class="doc-bank__link"
                    href={GUIDES_HREF}
                    aria-current={current === "guides" ? "page" : undefined}
                  >
                    All guides
                  </a>
                </li>
                {tasks.map((g) => (
                  <li>
                    <a
                      class="doc-bank__link"
                      href={guideHref(g.id)}
                      aria-current={current === `guides/${g.id}` ? "page" : undefined}
                    >
                      {g.data.nav}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </>
      ))
    }
  </nav>
</details>

<script>
  // Open is the served state. This collapses it on a narrow viewport and restores it
  // when there is room again, so a reader can never end up on a wide screen with the
  // index closed and its handle hidden.
  const index = document.querySelector<HTMLDetailsElement>(".doc-index");
  if (index) {
    const narrow = window.matchMedia("(max-width: 1080px)");
    const apply = (matches: boolean) => {
      index.open = !matches;
    };
    apply(narrow.matches);
    narrow.addEventListener("change", (e) => apply(e.matches));
  }
</script>
