---
/**
 * A miniature two-pen record, rendered at build time so a table of forty rows
 * costs no JavaScript. Same grammar as the Drum: the machine pen steps, the
 * human pen is written, and the machine line carries its ridge of displaced
 * soot rather than a glow.
 */
interface Props {
  machines: number[];
  readers: number[];
  width?: number;
  height?: number;
  label: string;
}

const { machines, readers, width = 96, height = 26, label } = Astro.props;

const max = Math.max(1, ...machines, ...readers);
const mid = height / 2;
const step = (i: number, n: number) => (n <= 1 ? width / 2 : (i / (n - 1)) * width);

function stepped(vals: number[]): string {
  if (!vals.length) return "";
  const pts = vals.map((v, i) => [step(i, vals.length), mid - (v / max) * (mid - 1)] as const);
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const m = (pts[i - 1][0] + pts[i][0]) / 2;
    d += `L${m},${pts[i - 1][1]}L${m},${pts[i][1]}L${pts[i][0]},${pts[i][1]}`;
  }
  return d;
}

function written(vals: number[]): string {
  if (!vals.length) return "";
  return vals
    .map((v, i) => `${i === 0 ? "M" : "L"}${step(i, vals.length)},${mid + (v / max) * (mid - 1)}`)
    .join("");
}
---

<svg
  class="mf-spark"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  role="img"
  aria-label={label}
  preserveAspectRatio="none"
>
  <line x1="0" y1={mid} x2={width} y2={mid} stroke="var(--mf-rule-major)" stroke-width="1" />
  <path
    d={stepped(machines)}
    fill="none"
    stroke="var(--mf-trace-agent)"
    stroke-width="1.3"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  />
  <path
    d={written(readers)}
    fill="none"
    stroke="var(--mf-trace-human)"
    stroke-width="1.3"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  />
</svg>

<style>
  .mf-spark {
    display: block;
    overflow: visible;
  }
</style>
